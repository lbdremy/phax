{
  "name": "@steme-lab/cli-command-commander",
  "version": "0.1.0",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -b tsconfig.build.json",
    "build": "tsc -b tsconfig.build.json",
    "lint": "oxlint --config ../../../.oxlintrc.fast.json src/ tests/ edge.ts refused.ts",
    "format": "oxfmt --config ../../../.oxfmtrc.json src/ tests/ edge.ts refused.ts",
    "format:check": "oxfmt --check --config ../../../.oxfmtrc.json src/ tests/ edge.ts refused.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@steme-lab/cli-command": "workspace:*",
    "effect": "4.0.4"
  },
  "peerDependencies": {
    "@steme-lab/cli-command": "^0.1",
    "effect": "^4"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/libraries/typescript/cli-command/rename-todo.command.ts"
        ]
      },
      "typecheck": {
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/libraries/typescript/cli-command/rename-todo.command.ts"
        ]
      }
    }
  }
}
