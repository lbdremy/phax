{
  "name": "phax",
  "version": "0.37.0",
  "description": "phax runs a plan through AI coding agents — Claude Code, OpenAI Codex or Mistral Vibe — as a sequence of gated phases, and hands you a change you can review.",
  "license": "Apache-2.0",
  "bin": {
    "phax": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "phax.usage.kdl",
    ".claude/skills/phax-planning",
    ".claude/skills/phax-cli",
    ".claude/skills/phax-spec",
    ".claude/skills/phax-review",
    ".claude/skills/phax-decide-spec",
    ".claude/skills/phax-decide-plan",
    ".claude/skills/phax-decide-review"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p packages/schemas/tsconfig.build.json && tsx scripts/schemas-json.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:type": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "gen:usage-spec": "tsx scripts/generate-usage-spec.ts",
    "gen:model-catalog": "tsx scripts/generate-model-catalog.ts",
    "docs:cli": "tsx scripts/docs-cli.ts",
    "site:build": "tsx site/build/site.ts build",
    "site:dev": "tsx site/build/site.ts dev",
    "site:preview": "tsx site/build/site.ts preview",
    "site:og": "tsx site/build/og.ts",
    "audit:architecture": "vitest run tests/unit/architecturalGuards.test.ts",
    "audit:security": "bash scripts/security/run-audit.sh",
    "check:full": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:type && npm run lint && npm run format:check && npm run audit:architecture && npm run knip && npm run gen:model-catalog -- --check",
    "test:e2e:real": "vitest run --config vitest.e2e.config.ts",
    "deno:smoke": "deno run --sloppy-imports --allow-read --allow-env --allow-sys --allow-run src/cli/main.ts --version",
    "deno:check": "deno check src/cli/main.ts",
    "deno:compile": "deno task compile",
    "deno:build-binaries": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build-binaries.ts",
    "deno:smoke-binary": "sh scripts/smoke-binary.sh",
    "release": "bash scripts/release.sh",
    "release:notes": "tsx scripts/release-notes.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^12.0.0",
    "effect": "^4.1.4",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@rspress/core": "^2.1.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/react": "19.3.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "knip": "^6.45.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxc-parser": "0.157.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.1"
}
