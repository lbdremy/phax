{
  "nodeModulesDir": "manual",
  "lock": {
    "frozen": true
  },
  "compile": {
    "exclude": ["node_modules"]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "ES2023"]
  },
  "fmt": {
    "exclude": ["**/*"]
  },
  "lint": {
    "exclude": ["**/*"]
  },
  "tasks": {
    "dev": "deno run --sloppy-imports --allow-read --allow-write --allow-env --allow-sys --allow-run src/cli/main.ts",
    "check": "deno check --sloppy-imports src/cli/main.ts",
    "compile": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build-binaries.ts --host"
  }
}
