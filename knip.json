{
  "entry": [
    "src/schemas/*.ts",
    "src/domain/*.ts",
    "src/ports/*.ts",
    "src/infra/*.ts",
    "src/infra/fakes/*.ts",
    "src/app/*.ts",
    "tests/**/*.test.ts",
    "tests/type/*.ts",
    "packages/schemas/src/index.ts",
    "packages/schemas/build/*.ts",
    "site/rspress.config.ts",
    "site/pages.ts",
    "site/build/*.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "packages/schemas/**/*.ts", "site/**/*.ts"],
  "ignore": ["site/generated/**", "site/doc_build/**"],
  "ignoreDependencies": [
    "@effect/platform",
    "@effect/platform-node",
    "esbuild",
    "@fontsource/ibm-plex-sans",
    "@fontsource/ibm-plex-mono"
  ],
  "ignoreFiles": ["tests/e2e/fixtures/**"],
  "ignoreBinaries": ["claude", "gh", "usage"]
}
