{
  "entry": [
    "src/schemas/*.ts",
    "src/domain/*.ts",
    "src/ports/*.ts",
    "src/infra/*.ts",
    "src/infra/fakes/*.ts",
    "src/app/*.ts",
    "tests/**/*.test.ts",
    "tests/type/*.ts",
    "packages/schemas/src/index.ts",
    "packages/schemas/build/*.ts",
    "site/rspress.config.ts",
    "site/pages.ts",
    "site/build/*.ts",
    "site/theme/index.tsx",
    "site/theme/css.d.ts",
    "examples/vitest-acceptance/main.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "packages/schemas/**/*.ts",
    "site/**/*.{ts,tsx}",
    "examples/vitest-acceptance/**/*.mjs"
  ],
  "ignoreDependencies": [
    "esbuild",
    "@fontsource/ibm-plex-sans",
    "@fontsource/ibm-plex-mono",
    "react"
  ],
  "ignoreFiles": ["tests/e2e/fixtures/**"],
  "ignoreBinaries": ["usage", "vibe"]
}
