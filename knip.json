{
  "entry": [
    "src/schemas/*.ts",
    "src/domain/*.ts",
    "src/ports/*.ts",
    "src/infra/*.ts",
    "src/infra/fakes/*.ts",
    "src/app/*.ts",
    "tests/**/*.test.ts",
    "tests/type/*.ts",
    "packages/schemas/src/index.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "packages/schemas/**/*.ts"],
  "ignoreDependencies": ["@effect/platform", "@effect/platform-node", "esbuild"],
  "ignoreFiles": ["tests/e2e/fixtures/**"],
  "ignoreBinaries": ["claude", "gh", "usage"]
}
