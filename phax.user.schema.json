{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    }
  },
  "type": "object",
  "required": [],
  "properties": {
    "state": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [],
      "properties": {
        "maxFixAttempts": {
          "$ref": "#/$defs/Int",
          "description": "a number between 1 and 10",
          "title": "between(1, 10)",
          "minimum": 1,
          "maximum": 10
        },
        "extractPlan": {
          "type": "object",
          "required": [],
          "properties": {
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": [],
      "properties": {
        "setup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "cleanup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "fileReconciliation": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["report_only", "warn"]
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["secure", "unsafe", "isolated"]
        },
        "filesystem": {
          "type": "object",
          "required": [],
          "properties": {
            "allowRead": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyString"
              }
            },
            "allowWrite": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyString"
              }
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": [],
          "properties": {
            "profile": {
              "type": "string",
              "enum": ["provider-only", "dev-allowlist", "open"]
            }
          },
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "required": [],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["disabled", "local-only", "allowlist", "provider-default"]
            },
            "allow": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyString"
              }
            }
          },
          "additionalProperties": false
        },
        "agentCommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "required": ["auto"],
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "remote": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "provider": {
          "type": "string",
          "enum": ["github"]
        },
        "pushBranch": {
          "type": "boolean"
        },
        "createPullRequest": {
          "type": "boolean"
        },
        "baseBranch": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "orient": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "The orient provider command. The string is split on whitespace with no shell — use a wrapper script for paths with spaces or pipelines. phax writes a JSON request to the provider's stdin and reads a JSON response from stdout. Full contract: `phax --usage`, cmd orient.",
          "title": "nonEmptyString",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "The scopes provider command. The string is split on whitespace with no shell — use a wrapper script for paths with spaces or pipelines. phax writes the plan projection ({\"phase\", \"phases\": [{\"id\", \"files\"}]}) to the provider's stdin before each non-terminal phase gate that has a diagnostic step and expects exit 0 with {\"closed\": [\"<scope>\", ...]} on stdout. A completion diagnostic fails the step only when every scope it names is closed, otherwise it is pending; the terminal phase closes every scope without a query. Full contract: `phax --usage`, cmd run.",
          "title": "nonEmptyString",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [],
      "properties": {
        "compliance": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        },
        "code": {
          "type": "object",
          "required": [],
          "properties": {
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gateProfiles": {
      "type": "object",
      "required": [],
      "properties": {},
      "patternProperties": {
        "": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "surface", "firing"],
            "properties": {
              "command": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "surface": {
                "type": "string",
                "enum": ["local", "structural", "product"]
              },
              "firing": {
                "type": "string",
                "enum": ["every-phase", "terminal"]
              },
              "output": {
                "type": "string",
                "enum": ["log", "diagnostics"],
                "description": "\"log\" (default) streams raw command output. \"diagnostics\" expects {\"diagnostics\": [{\"rule\", \"class\": \"invariant\"|\"completion\", \"scopes\"?: [...], \"location\": {\"file\", \"line\"?}, \"message\", \"repair\"}]} on stdout. Verdict rules: a non-empty list fails the step whatever the exit code; exit 0 with an empty list passes; a missing or undecodable document, or a non-zero exit with an empty list, is a provider error that fails the step with the raw log. A failing document is saved as checks-attempt-NN.diagnostics.json and drives the fix prompt. A completion diagnostic names one or more scopes and is pending — not failing — until every scope it names is closed by the \"scopes\" provider."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "name": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "path": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "gateProfiles": {
            "type": "object",
            "required": [],
            "properties": {},
            "patternProperties": {
              "": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["command", "surface", "firing"],
                  "properties": {
                    "command": {
                      "$ref": "#/$defs/NonEmptyString"
                    },
                    "surface": {
                      "type": "string",
                      "enum": ["local", "structural", "product"]
                    },
                    "firing": {
                      "type": "string",
                      "enum": ["every-phase", "terminal"]
                    },
                    "output": {
                      "type": "string",
                      "enum": ["log", "diagnostics"],
                      "description": "\"log\" (default) streams raw command output. \"diagnostics\" expects {\"diagnostics\": [{\"rule\", \"class\": \"invariant\"|\"completion\", \"scopes\"?: [...], \"location\": {\"file\", \"line\"?}, \"message\", \"repair\"}]} on stdout. Verdict rules: a non-empty list fails the step whatever the exit code; exit 0 with an empty list passes; a missing or undecodable document, or a non-zero exit with an empty list, is a provider error that fails the step with the raw log. A failing document is saved as checks-attempt-NN.diagnostics.json and drives the fix prompt. A completion diagnostic names one or more scopes and is pending — not failing — until every scope it names is closed by the \"scopes\" provider."
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "propertyNames": {
              "$ref": "#/$defs/NonEmptyString"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
