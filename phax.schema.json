{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    }
  },
  "type": "object",
  "required": ["version", "name", "gateProfiles"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "enum": [1]
    },
    "name": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "state": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": [],
      "properties": {
        "maxFixAttempts": {
          "$ref": "#/$defs/Int",
          "description": "a number between 1 and 10",
          "title": "between(1, 10)",
          "minimum": 1,
          "maximum": 10
        },
        "extractPlan": {
          "type": "object",
          "required": [],
          "properties": {
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "required": [],
      "properties": {
        "setup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "cleanup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "fileReconciliation": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["report_only", "warn"]
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["secure", "unsafe", "isolated"]
        },
        "filesystem": {
          "type": "object",
          "required": [],
          "properties": {
            "allowRead": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyString"
              }
            },
            "allowWrite": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyString"
              }
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "required": [],
          "properties": {
            "profile": {
              "type": "string",
              "enum": ["provider-only", "dev-allowlist", "open"]
            }
          },
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "required": [],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["disabled", "local-only", "allowlist", "provider-default"]
            },
            "allow": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NonEmptyString"
              }
            }
          },
          "additionalProperties": false
        },
        "agentCommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "required": ["auto"],
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "remote": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "provider": {
          "type": "string",
          "enum": ["github"]
        },
        "pushBranch": {
          "type": "boolean"
        },
        "createPullRequest": {
          "type": "boolean"
        },
        "baseBranch": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "The brief provider command, split on whitespace with no shell. phax writes a brief request on its stdin and reads a brief answer, carrying its own $schema, on stdout. A brief informs and never blocks. Full contract: `phax --usage`, cmd brief.",
          "title": "nonEmptyString",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "planAuditor": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "The plan auditor command. The string is split on whitespace with no shell — use a wrapper script for paths with spaces or pipelines. phax writes the plan projection ({\"phases\": [{\"id\", \"files\"}]}) to the provider's stdin from `phax plans lint` whenever the plan's deterministic extraction succeeds, and expects exit 0 with {\"findings\": [{\"message\", \"phases\": [...]}]} on stdout. Every finding is a warning on the lint's advisory check, one per phase it names; a failing auditor is one warning, and the command is capped at 30s; findings never set the exit code. `phax run` never queries it. Full contract: `phax --usage`, cmd plans lint.",
          "title": "nonEmptyString",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [],
      "properties": {
        "compliance": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        },
        "code": {
          "type": "object",
          "required": [],
          "properties": {
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authoring": {
      "type": "object",
      "required": [],
      "properties": {
        "spec": {
          "type": "object",
          "required": [],
          "properties": {
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "required": [],
          "properties": {
            "model": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gateProfiles": {
      "type": "object",
      "required": [],
      "properties": {},
      "patternProperties": {
        "": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "surface", "firing"],
            "properties": {
              "command": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "surface": {
                "type": "string",
                "enum": ["local", "structural", "product"]
              },
              "firing": {
                "type": "string",
                "enum": ["every-phase", "terminal"]
              },
              "output": {
                "type": "string",
                "enum": ["log", "gate-report"],
                "description": "\"log\" (default) streams raw command output. \"gate-report\": phax reads a gate report {\"$schema\": \"https://docs.phax.run/schemas/gate-report/<release>.json\", \"outcome\": \"checked\", \"findings\", \"review\"} on stdout, judges the step from it and saves it as printed as checks-attempt-NN.report-SS.json, SS being the step's position among the steps the attempt runs. Any finding fails the step whatever the exit code; an empty list passes on exit 0; anything else is a broken step that fails with the raw log. A report step does not have to declare input."
              },
              "input": {
                "type": "string",
                "enum": ["gate-request"],
                "description": "Absent: the step's stdin is not connected. \"gate-request\": phax writes the gate request {$schema, phase, base, terminal, phases} on the step's stdin and saves it as checks-attempt-NN.request.json."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "name": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "path": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "gateProfiles": {
            "type": "object",
            "required": [],
            "properties": {},
            "patternProperties": {
              "": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["command", "surface", "firing"],
                  "properties": {
                    "command": {
                      "$ref": "#/$defs/NonEmptyString"
                    },
                    "surface": {
                      "type": "string",
                      "enum": ["local", "structural", "product"]
                    },
                    "firing": {
                      "type": "string",
                      "enum": ["every-phase", "terminal"]
                    },
                    "output": {
                      "type": "string",
                      "enum": ["log", "gate-report"],
                      "description": "\"log\" (default) streams raw command output. \"gate-report\": phax reads a gate report {\"$schema\": \"https://docs.phax.run/schemas/gate-report/<release>.json\", \"outcome\": \"checked\", \"findings\", \"review\"} on stdout, judges the step from it and saves it as printed as checks-attempt-NN.report-SS.json, SS being the step's position among the steps the attempt runs. Any finding fails the step whatever the exit code; an empty list passes on exit 0; anything else is a broken step that fails with the raw log. A report step does not have to declare input."
                    },
                    "input": {
                      "type": "string",
                      "enum": ["gate-request"],
                      "description": "Absent: the step's stdin is not connected. \"gate-request\": phax writes the gate request {$schema, phase, base, terminal, phases} on the step's stdin and saves it as checks-attempt-NN.request.json."
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "propertyNames": {
              "$ref": "#/$defs/NonEmptyString"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "object",
      "required": ["transcript", "destination", "autoPush"],
      "properties": {
        "transcript": {
          "type": "boolean"
        },
        "destination": {
          "anyOf": [
            {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["in-repo"]
                },
                "acknowledgedUnknownVisibility": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "remote"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["repo"]
                },
                "remote": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "autoPush": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
