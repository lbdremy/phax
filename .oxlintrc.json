{
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "prefer-const": "error",
    "no-floating-promises": "error",
    "no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "coverage/",
    "examples/**/dist",
    "tests/**/__fixtures__/",
    "site/generated/",
    "site/doc_build/"
  ]
}
