{
  "subject": "answers/claude-output",
  "cases": [
    {
      "name": "reads a session that succeeded",
      "input": [
        "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"sess-1\",\"model\":\"claude-opus-5-5\"}",
        "{\"type\":\"assistant\",\"message\":{\"content\":[]}}",
        "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"Done.\",\"session_id\":\"sess-1\",\"duration_ms\":1200}"
      ],
      "expected": {
        "ok": true,
        "value": {
          "initSessionId": "sess-1",
          "result": {
            "is_error": false,
            "result": "Done.",
            "session_id": "sess-1",
            "subtype": "success",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "reads a structured output and keeps no unknown key",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "sess-1",
          "model": "claude-opus-5-5"
        },
        {
          "type": "result",
          "subtype": "success",
          "is_error": false,
          "result": "Done.",
          "session_id": "sess-1",
          "duration_ms": 1200,
          "structured_output": {
            "$schema": "x",
            "findings": []
          },
          "permission_denials": []
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "initSessionId": "sess-1",
          "result": {
            "is_error": false,
            "result": "Done.",
            "session_id": "sess-1",
            "structured_output": {
              "$schema": "x",
              "findings": []
            },
            "subtype": "success",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "reads a session ended by an API error",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "sess-1",
          "model": "claude-opus-5-5"
        },
        {
          "type": "assistant",
          "is_api_error_message": true,
          "error": "rate_limit",
          "message": {}
        },
        {
          "type": "result",
          "subtype": "success",
          "is_error": true,
          "result": "API Error: 429",
          "terminal_reason": "api_error",
          "api_error_status": 429
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "apiErrorCategory": "rate_limit",
          "initSessionId": "sess-1",
          "result": {
            "api_error_status": 429,
            "is_error": true,
            "result": "API Error: 429",
            "subtype": "success",
            "terminal_reason": "api_error",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "reads a connection failure's null status",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "sess-1",
          "model": "claude-opus-5-5"
        },
        {
          "type": "result",
          "subtype": "success",
          "is_error": true,
          "terminal_reason": "api_error",
          "api_error_status": null,
          "errors": [
            "fetch failed"
          ]
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "initSessionId": "sess-1",
          "result": {
            "api_error_status": null,
            "errors": [
              "fetch failed"
            ],
            "is_error": true,
            "subtype": "success",
            "terminal_reason": "api_error",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "keeps a trailing API retry",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "sess-1",
          "model": "claude-opus-5-5"
        },
        {
          "type": "system",
          "subtype": "api_retry",
          "attempt": 3,
          "max_retries": 10,
          "error_status": 529,
          "error": "overloaded"
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "initSessionId": "sess-1",
          "trailingApiRetry": {
            "attempt": 3,
            "error": "overloaded",
            "error_status": 529,
            "max_retries": 10,
            "subtype": "api_retry",
            "type": "system"
          }
        }
      }
    },
    {
      "name": "drops a retry the session got past",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "sess-1",
          "model": "claude-opus-5-5"
        },
        {
          "type": "system",
          "subtype": "api_retry",
          "error_status": null,
          "error": "unknown"
        },
        {
          "type": "result",
          "subtype": "success",
          "is_error": false,
          "result": "Done.",
          "session_id": "sess-1",
          "duration_ms": 1200
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "initSessionId": "sess-1",
          "result": {
            "is_error": false,
            "result": "Done.",
            "session_id": "sess-1",
            "subtype": "success",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "reads a rejected rate limit's reset time",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "sess-1",
          "model": "claude-opus-5-5"
        },
        {
          "type": "rate_limit_event",
          "rate_limit_info": {
            "status": "rejected",
            "resetsAt": 1793000000
          }
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "initSessionId": "sess-1",
          "rejectedResetsAt": 1793000000
        }
      }
    },
    {
      "name": "skips an allowed rate limit",
      "input": [
        {
          "type": "rate_limit_event",
          "rate_limit_info": {
            "status": "allowed",
            "resetsAt": 1793000000
          }
        }
      ],
      "expected": {
        "ok": true,
        "value": {}
      }
    },
    {
      "name": "skips a line that is not JSON and a blank line",
      "input": [
        "not json",
        "",
        "   ",
        "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"Done.\",\"session_id\":\"sess-1\",\"duration_ms\":1200}"
      ],
      "expected": {
        "ok": true,
        "value": {
          "result": {
            "is_error": false,
            "result": "Done.",
            "session_id": "sess-1",
            "subtype": "success",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "skips a result missing is_error",
      "input": [
        {
          "type": "result",
          "subtype": "success",
          "is_error": false,
          "result": "Done.",
          "session_id": "sess-1",
          "duration_ms": 1200
        },
        {
          "type": "result",
          "subtype": "success",
          "result": "later",
          "session_id": "sess-1",
          "duration_ms": 1200
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "result": {
            "is_error": false,
            "result": "Done.",
            "session_id": "sess-1",
            "subtype": "success",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "skips a result whose is_error is not a boolean",
      "input": [
        {
          "type": "result",
          "subtype": "success",
          "is_error": "false",
          "result": "Done.",
          "session_id": "sess-1",
          "duration_ms": 1200
        }
      ],
      "expected": {
        "ok": true,
        "value": {}
      }
    },
    {
      "name": "skips an init with an empty session id",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "",
          "model": "claude-opus-5-5"
        },
        {
          "type": "result",
          "subtype": "success",
          "is_error": false,
          "result": "Done.",
          "session_id": "sess-1",
          "duration_ms": 1200
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "result": {
            "is_error": false,
            "result": "Done.",
            "session_id": "sess-1",
            "subtype": "success",
            "type": "result"
          }
        }
      }
    },
    {
      "name": "skips an init subtype outside init",
      "input": [
        {
          "type": "system",
          "subtype": "compact_boundary",
          "session_id": "sess-1",
          "model": "claude-opus-5-5"
        }
      ],
      "expected": {
        "ok": true,
        "value": {}
      }
    },
    {
      "name": "skips an api retry whose error status is missing",
      "input": [
        {
          "type": "system",
          "subtype": "api_retry",
          "error": "overloaded"
        }
      ],
      "expected": {
        "ok": true,
        "value": {}
      }
    },
    {
      "name": "skips a JSON value that is not an object",
      "input": [
        "[1,2]",
        "42",
        "\"text\""
      ],
      "expected": {
        "ok": true,
        "value": {}
      }
    }
  ]
}
