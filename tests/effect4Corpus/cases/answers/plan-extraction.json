{
  "subject": "answers/plan-extraction",
  "cases": [
    {
      "name": "reads an extracted plan",
      "input": {
        "$schema": "https://docs.phax.run/schemas/phax-plan-extraction/0.33.0.json",
        "plan": {
          "run": {
            "shortName": "my-run",
            "title": "My Run",
            "requiredCommands": [
              "pnpm build"
            ]
          },
          "phases": [
            {
              "id": "phase-01",
              "model": "claude-sonnet-5-5",
              "effort": "medium",
              "planMarkdownAnchor": "#phase-01-first",
              "plannedFilesToCreate": [
                "src/first.ts"
              ],
              "plannedFilesToEdit": [],
              "optionalFilesToEdit": [],
              "testLines": [
                {
                  "guarantee": "the first module answers",
                  "size": "small",
                  "technique": "example",
                  "oracle": "its return value",
                  "loop": "in-phase",
                  "criterion": null
                }
              ],
              "commit": {
                "subject": "feat: first",
                "body": "Body."
              }
            }
          ]
        },
        "incomplete": null
      },
      "expected": {
        "ok": true,
        "value": {
          "kind": "plan",
          "plan": {
            "phases": [
              {
                "commit": {
                  "body": "Body.",
                  "subject": "feat: first"
                },
                "effort": "medium",
                "id": "phase-01",
                "model": "claude-sonnet-5-5",
                "optionalFilesToEdit": [],
                "planMarkdownAnchor": "#phase-01-first",
                "plannedFilesToCreate": [
                  "src/first.ts"
                ],
                "plannedFilesToEdit": [],
                "testLines": [
                  {
                    "criterion": null,
                    "guarantee": "the first module answers",
                    "loop": "in-phase",
                    "oracle": "its return value",
                    "size": "small",
                    "technique": "example"
                  }
                ]
              }
            ],
            "run": {
              "requiredCommands": [
                "pnpm build"
              ],
              "shortName": "my-run",
              "title": "My Run"
            }
          }
        }
      }
    },
    {
      "name": "reads an incomplete report",
      "input": {
        "$schema": "https://docs.phax.run/schemas/phax-plan-extraction/0.33.0.json",
        "plan": null,
        "incomplete": "phase-02 has no commit subject"
      },
      "expected": {
        "ok": true,
        "value": {
          "kind": "incomplete",
          "reason": "phase-02 has no commit subject"
        }
      }
    },
    {
      "name": "refuses an older answer naming every root difference, $schema first",
      "input": {
        "version": 1,
        "plan": null,
        "incomplete": "phase-02 has no commit subject"
      },
      "expected": {
        "ok": false,
        "refusal": "$schema: is missing; version: is unexpected, expected: \"$schema\" | \"plan\" | \"incomplete\""
      }
    },
