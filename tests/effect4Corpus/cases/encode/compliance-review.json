{
  "subject": "encode/compliance-review",
  "cases": [
    {
      "name": "accepts a typical document",
      "input": {
        "$schema": "https://docs.phax.run/schemas/compliance-review/0.32.0.json",
        "verdict": "conformant-with-deviations",
        "summary": "The run delivers the plan, with one deviation.",
        "perPhase": [
          {
            "phaseId": "phase-01",
            "verdict": "conformant-with-deviations",
            "findings": [
              {
                "dimension": "files",
                "severity": "deviation",
                "message": "README.md was touched"
              }
            ]
          }
        ],
        "unplannedChanges": [
          {
            "phaseId": "phase-01",
            "path": "README.md",
            "note": "The plan did not list it"
          }
        ],
        "unmetPromises": [
          {
            "phaseId": "phase-01",
            "promise": "A test for the example",
            "note": "No such test exists"
          }
        ],
        "attentionPoints": [
          "README.md changed"
        ],
        "pointers": [
          "src/example.ts"
        ]
      },
      "expected": {
        "ok": true,
        "value": {
          "$schema": "https://docs.phax.run/schemas/compliance-review/0.32.0.json",
          "attentionPoints": [
            "README.md changed"
          ],
          "perPhase": [
            {
              "findings": [
                {
                  "dimension": "files",
                  "message": "README.md was touched",
                  "severity": "deviation"
                }
              ],
              "phaseId": "phase-01",
              "verdict": "conformant-with-deviations"
            }
          ],
          "pointers": [
            "src/example.ts"
          ],
          "summary": "The run delivers the plan, with one deviation.",
          "unmetPromises": [
            {
              "note": "No such test exists",
              "phaseId": "phase-01",
              "promise": "A test for the example"
            }
          ],
          "unplannedChanges": [
            {
              "note": "The plan did not list it",
              "path": "README.md",
              "phaseId": "phase-01"
            }
          ],
          "verdict": "conformant-with-deviations"
        }
      }
