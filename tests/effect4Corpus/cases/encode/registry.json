              "shortName": "example-run",
              "state": "running",
              "updatedAt": "2026-01-01T09:30:00.000Z"
            }
          ]
        }
      }
    },
    {
      "name": "accepts an unexpected key without reading it",
      "input": {
        "$schema": "https://docs.phax.run/schemas/registry/0.26.0.json",
        "runs": [
          {
            "namespace": "example",
            "shortName": "example-run",
            "runId": "run-0001",
            "state": "running",
            "branch": "phax/example-run",
            "projectName": "example-repo",
            "phasesCount": 2,
            "createdAt": "2026-01-01T09:00:00.000Z",
            "updatedAt": "2026-01-01T09:30:00.000Z"
          }
        ],
        "unexpectedKey": 1
      },
      "expected": {
        "ok": true,
        "value": {
          "$schema": "https://docs.phax.run/schemas/registry/0.26.0.json",
          "runs": [
            {
              "branch": "phax/example-run",
              "createdAt": "2026-01-01T09:00:00.000Z",
              "namespace": "example",
              "phasesCount": 2,
              "projectName": "example-repo",
              "runId": "run-0001",
              "shortName": "example-run",
