{
  "subject": "encode/spec-approval-record",
  "cases": [
    {
      "name": "accepts a typical document",
      "input": {
        "$schema": "https://docs.phax.run/schemas/spec-approval-record/0.25.0.json",
        "artifact": "docs/specs/example.md",
        "specFingerprint": "spec-fingerprint-0001",
        "approvedAt": "2026-01-01T09:00:00.000Z",
        "baseline": "0123456789abcdef0123456789abcdef01234567",
        "approvedBy": {
          "kind": "operator",
          "name": "Ada Lovelace"
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "$schema": "https://docs.phax.run/schemas/spec-approval-record/0.25.0.json",
          "approvedAt": "2026-01-01T09:00:00.000Z",
          "approvedBy": {
            "kind": "operator",
            "name": "Ada Lovelace"
          },
          "artifact": "docs/specs/example.md",
          "baseline": "0123456789abcdef0123456789abcdef01234567",
          "specFingerprint": "spec-fingerprint-0001"
        }
      }
    },
    {
      "name": "accepts a document setting every field",
      "input": {
        "$schema": "https://docs.phax.run/schemas/spec-approval-record/0.25.0.json",
        "artifact": "docs/specs/example.md",
        "specFingerprint": "spec-fingerprint-0001",
        "approvedAt": "2026-01-01T09:00:00.000Z",
        "baseline": "0123456789abcdef0123456789abcdef01234567",
        "approvedBy": {
          "kind": "machine",
          "grant": "slug"
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "$schema": "https://docs.phax.run/schemas/spec-approval-record/0.25.0.json",
          "approvedAt": "2026-01-01T09:00:00.000Z",
          "approvedBy": {
            "grant": "slug",
            "kind": "machine"
          },
          "artifact": "docs/specs/example.md",
          "baseline": "0123456789abcdef0123456789abcdef01234567",
          "specFingerprint": "spec-fingerprint-0001"
        }
      }
    },
    {
      "name": "accepts a document with only its required fields",
      "input": {
        "$schema": "https://docs.phax.run/schemas/spec-approval-record/0.25.0.json",
        "artifact": "docs/specs/example.md",
        "specFingerprint": "spec-fingerprint-0001",
        "approvedAt": "2026-01-01T09:00:00.000Z",
        "baseline": "0123456789abcdef0123456789abcdef01234567",
        "approvedBy": {
          "kind": "machine",
          "grant": "slug"
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "$schema": "https://docs.phax.run/schemas/spec-approval-record/0.25.0.json",
          "approvedAt": "2026-01-01T09:00:00.000Z",
          "approvedBy": {
            "grant": "slug",
            "kind": "machine"
          },
          "artifact": "docs/specs/example.md",
          "baseline": "0123456789abcdef0123456789abcdef01234567",
          "specFingerprint": "spec-fingerprint-0001"
        }
      }
    }
  ]
