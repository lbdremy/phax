              "phase-01"
            ],
            "selection": "all"
          },
          "lastError": "text-8",
          "namespace": "example",
          "phasesCount": 2,
          "planRepoRelPath": "text-9",
          "runId": "run-0001",
          "shortName": "example-run",
          "state": "running",
          "stoppedReason": "text-7",
          "updatedAt": "2026-01-01T09:30:00.000Z"
        }
      }
    },
    {
