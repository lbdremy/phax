          "README.md changed"
        ],
        "pointers": [
          "src/example.ts"
        ]
      },
      "expected": {
        "ok": true,
        "shape": "0.32.0",
        "value": {
          "$schema": "https://docs.phax.run/schemas/compliance-review/0.32.0.json",
