{
  "format": "oracle-request",
  "current": [
    {
      "name": "accepts a typical document",
      "input": {
        "$schema": "https://docs.phax.run/schemas/oracle-request/0.26.0.json",
        "verdict": "authored",
        "phase": "phase-02",
        "oraclePhase": "phase-02",
        "base": "0123456789abcdef0123456789abcdef01234567",
        "files": [
          "tests/prune.test.ts"
        ]
      },
      "expected": {
        "ok": true,
        "shape": "0.26.0",
        "value": {
          "$schema": "https://docs.phax.run/schemas/oracle-request/0.26.0.json",
          "base": "0123456789abcdef0123456789abcdef01234567",
          "files": [
            "tests/prune.test.ts"
          ],
          "oraclePhase": "phase-02",
          "phase": "phase-02",
          "verdict": "authored"
        }
      }
    },
    {
      "name": "accepts a document setting every field",
      "input": {
        "$schema": "https://docs.phax.run/schemas/oracle-request/0.26.0.json",
        "verdict": "discharged",
        "phase": "phase-02",
        "oraclePhase": "phase-02",
        "base": "0123456789abcdef0123456789abcdef01234567",
        "oracleCommit": "0123456789abcdef0123456789abcdef01234567",
