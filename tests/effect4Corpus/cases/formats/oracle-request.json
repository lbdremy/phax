          "$schema": "https://docs.phax.run/schemas/oracle-request/0.26.0.json",
          "base": "0123456789abcdef0123456789abcdef01234567",
          "files": [
            "tests/prune.test.ts"
          ],
          "oracleCommit": "0123456789abcdef0123456789abcdef01234567",
          "oraclePhase": "phase-02",
          "phase": "phase-02",
          "verdict": "discharged"
        }
      }
    },
    {
      "name": "accepts a document with only its required fields",
