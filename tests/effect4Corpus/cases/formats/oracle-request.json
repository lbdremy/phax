          ],
          "oracleCommit": "0123456789abcdef0123456789abcdef01234567",
          "oraclePhase": "phase-02",
          "phase": "phase-02",
          "verdict": "discharged"
        }
      }
    },
    {
      "name": "refuses a document that is not an object",
      "input": [
        "not",
        "an",
        "object"
      ],
      "expected": {
        "ok": false,
        "refusal": ": a document is a JSON object, got an array"
      }
    },
    {
      "name": "refuses a malformed $schema",
      "input": {
        "$schema": "not a schema url",
        "verdict": "authored",
        "phase": "phase-02",
        "oraclePhase": "phase-02",
        "base": "0123456789abcdef0123456789abcdef01234567",
        "files": [
          "tests/prune.test.ts"
        ]
      },
      "expected": {
        "ok": false,
        "refusal": "$schema: expected https://docs.phax.run/schemas/<format-id>/<X.Y.Z>.json, got \"not a schema url\""
      }
    },
    {
      "name": "refuses a stamp newer than the package",
      "input": {
        "$schema": "https://docs.phax.run/schemas/oracle-request/9.0.0.json",
        "verdict": "authored",
        "phase": "phase-02",
        "oraclePhase": "phase-02",
        "base": "0123456789abcdef0123456789abcdef01234567",
        "files": [
          "tests/prune.test.ts"
        ]
      },
      "expected": {
        "ok": false,
