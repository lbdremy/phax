            "updatedAt": "2026-01-01T09:30:00.000Z"
          }
        ]
      },
      "expected": {
        "ok": false,
        "refusal": "$schema: https://docs.phax.run/schemas/registry/0.1.0.json was written by a development build of phax before 0.17.0, the first supported release — not supported"
      }
    },
