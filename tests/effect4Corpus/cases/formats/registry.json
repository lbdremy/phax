            "updatedAt": "2026-01-01T09:30:00.000Z"
          }
        ]
      },
      "expected": {
        "ok": false,
        "refusal": "$schema: registry 9.0.0 is newer than @lbdremy/phax-schemas 0.36.0 — upgrade the package"
      }
    },
    {
      "name": "refuses a stamp below the first supported release",
