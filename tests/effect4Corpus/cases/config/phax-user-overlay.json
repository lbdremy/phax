{
  "subject": "config/phax-user-overlay",
  "cases": [
    {
      "name": "accepts an empty overlay",
      "input": {},
      "expected": {
        "ok": true,
        "value": {}
      }
    },
    {
      "name": "accepts an overlay with state, agent, security and gate profiles",
      "input": {
        "state": {
          "root": "/tmp/phax"
        },
        "agent": {
          "maxFixAttempts": 2,
          "extractPlan": {
            "effort": "medium"
          }
        },
        "security": {
          "profile": "unsafe"
        },
        "review": {
          "code": {
            "enabled": true
          }
        },
        "gateProfiles": {
          "quick": [
            {
              "command": "pnpm typecheck",
              "surface": "local",
              "firing": "every-phase",
              "output": "gate-report"
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "agent": {
            "extractPlan": {
              "effort": "medium"
            },
            "maxFixAttempts": 2
          },
          "gateProfiles": {
            "quick": [
              {
                "command": "pnpm typecheck",
                "firing": "every-phase",
                "output": "gate-report",
                "surface": "local"
              }
            ]
          },
          "review": {
            "code": {
              "enabled": true
            }
          },
          "security": {
            "profile": "unsafe"
          },
          "state": {
            "root": "/tmp/phax"
          }
        }
      }
    },
    {
      "name": "refuses a project-only key name",
      "input": {
        "name": "demo"
      },
      "expected": {
        "ok": false,
        "refusal": "  name: is unexpected, expected: \"state\" | \"agent\" | \"commands\" | \"fileReconciliation\" | \"security\" | \"publish\" | \"brief\" | \"planAuditor\" | \"architecture\" | \"acceptance\" | \"review\" | \"authoring\" | \"gateProfiles\" | \"workspaces\""
      }
    },
    {
      "name": "refuses an unexpected key",
      "input": {
        "theme": "dark"
      },
      "expected": {
        "ok": false,
        "refusal": "  theme: is unexpected, expected: \"state\" | \"agent\" | \"commands\" | \"fileReconciliation\" | \"security\" | \"publish\" | \"brief\" | \"planAuditor\" | \"architecture\" | \"acceptance\" | \"review\" | \"authoring\" | \"gateProfiles\" | \"workspaces\""
      }
    },
    {
      "name": "refuses a state root that is not a string",
      "input": {
        "state": {
          "root": 7
        }
      },
      "expected": {
        "ok": false,
        "refusal": "  state.root: Expected string, actual 7"
      }
    },
    {
      "name": "refuses an empty state root",
      "input": {
        "state": {
          "root": ""
        }
      },
      "expected": {
        "ok": false,
        "refusal": "  state.root: Expected a non empty string, actual \"\""
      }
    },
    {
      "name": "refuses a network profile outside the enum",
      "input": {
        "security": {
          "network": {
            "profile": "closed"
          }
        }
      },
      "expected": {
        "ok": false,
        "refusal": "  security.network.profile: Expected \"provider-only\" | \"dev-allowlist\" | \"open\" | undefined, actual \"closed\""
      }
    },
    {
      "name": "refuses maxFixAttempts below the bound",
      "input": {
        "agent": {
          "maxFixAttempts": 0
        }
      },
      "expected": {
        "ok": false,
        "refusal": "  agent.maxFixAttempts: Expected a number between 1 and 10, actual 0"
      }
    },
    {
      "name": "refuses a missing compliance enabled",
      "input": {
        "review": {
          "compliance": {
            "model": "claude-sonnet-5-5"
          }
        }
      },
      "expected": {
        "ok": false,
        "refusal": "  review.compliance.enabled: is missing"
      }
    },
    {
      "name": "refuses a missing brief push once",
      "input": {
        "brief": {
          "command": "./brief.sh"
        }
      },
      "expected": {
        "ok": false,
        "refusal": "  brief.push must be \"findings\" or \"findings-and-rules\""
      }
    },
    {
      "name": "refuses a gate step output outside the enum, naming its command",
      "input": {
        "gateProfiles": {
          "quick": [
            {
              "command": "pnpm lint",
              "surface": "local",
              "firing": "every-phase",
              "output": "json"
            }
          ]
        }
      },
      "expected": {
        "ok": false,
        "refusal": "  gate step \"pnpm lint\": output must be \"log\" or \"gate-report\""
      }
    },
    {
      "name": "refuses an overlay that is not an object",
      "input": "phax",
      "expected": {
        "ok": false,
        "refusal": "  (root): Expected an object, actual \"phax\""
      }
    }
  ]
}
