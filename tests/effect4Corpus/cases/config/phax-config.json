    {
      "name": "accepts the minimal config, a step's output defaulting to log",
      "input": {
        "version": 1,
        "name": "demo",
        "gateProfiles": {
          "standard": [
            {
              "command": "pnpm test",
              "surface": "local",
              "firing": "every-phase"
            }
          ]
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "gateProfiles": {
            "standard": [
              {
                "command": "pnpm test",
                "firing": "every-phase",
                "output": "log",
                "surface": "local"
              }
            ]
          },
          "name": "demo",
          "version": 1
        }
      }
    },
    {
      "name": "accepts a config with every key",
      "input": {
        "$schema": "./node_modules/phax/schemas/phax.schema.json",
        "version": 1,
        "name": "demo",
        "state": {
          "root": "~/.phax"
        },
        "agent": {
          "maxFixAttempts": 3,
          "extractPlan": {
            "model": "claude-haiku-5-5",
            "effort": "low"
          }
        },
        "commands": {
          "setup": [
            "pnpm install"
          ],
          "cleanup": [
            "git clean -fdX"
          ]
        },
        "fileReconciliation": {
          "mode": "warn"
        },
        "security": {
          "profile": "secure",
          "filesystem": {
            "allowRead": [
              "~/.cache"
            ],
            "allowWrite": []
          },
          "network": {
            "profile": "dev-allowlist"
          },
          "mcp": {
            "mode": "allowlist",
            "allow": [
              "context7"
            ]
          },
          "agentCommands": [
            "pnpm add"
          ]
        },
        "publish": {
          "auto": false,
          "remote": "origin",
          "provider": "github",
          "pushBranch": true,
          "createPullRequest": true,
          "baseBranch": "main",
          "title": "phax run"
        },
        "brief": {
          "command": "./brief.sh",
          "push": "findings-and-rules"
        },
        "planAuditor": {
          "command": "./audit.sh"
        },
        "architecture": {
          "command": "./architecture.sh"
        },
        "acceptance": {
          "command": "./acceptance.sh"
        },
        "review": {
          "compliance": {
            "enabled": true,
            "model": "claude-sonnet-5-5",
            "effort": "medium"
          },
          "code": {
            "enabled": false,
            "effort": "high"
          }
        },
        "authoring": {
          "spec": {
            "model": "claude-opus-5-5",
            "effort": "high"
          },
          "plan": {
            "effort": "medium"
          }
        },
        "gateProfiles": {
          "standard": [
            {
              "command": "pnpm format",
              "surface": "local",
              "firing": "every-phase"
            },
            {
              "command": "pnpm lint",
              "surface": "local",
              "firing": "every-phase",
              "output": "log",
              "partial": {
                "files": "pnpm exec oxlint <files>",
                "diff": "git diff --name-only | xargs oxlint"
              }
            },
            {
              "command": "./review.sh",
              "surface": "structural",
              "firing": "terminal",
              "output": "gate-report",
              "input": "gate-request"
            },
            {
              "command": "pnpm build",
              "surface": "product",
              "firing": "terminal"
            }
          ]
        },
        "workspaces": [
          {
            "id": "site",
            "name": "Site",
            "path": "site",
            "gateProfiles": {
              "standard": [
                {
                  "command": "pnpm site:build",
                  "surface": "product",
                  "firing": "terminal"
                }
              ]
            }
          }
        ],
        "records": {
          "transcript": false,
          "destination": {
            "kind": "repo",
            "remote": "git@github.com:acme/records.git"
