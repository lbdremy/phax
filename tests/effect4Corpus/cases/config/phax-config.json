          "authoring": {
            "plan": {
              "effort": "medium"
            },
            "spec": {
              "effort": "high",
              "model": "claude-opus-5-5"
            }
          },
          "brief": {
            "command": "./brief.sh",
            "push": "findings-and-rules"
          },
          "commands": {
            "cleanup": [
              "git clean -fdX"
            ],
            "setup": [
              "pnpm install"
            ]
          },
          "fileReconciliation": {
            "mode": "warn"
          },
          "gateProfiles": {
            "standard": [
              {
                "command": "pnpm format",
                "firing": "every-phase",
                "output": "log",
                "surface": "local"
              },
              {
                "command": "pnpm lint",
                "firing": "every-phase",
                "output": "log",
                "partial": {
                  "diff": "git diff --name-only | xargs oxlint",
