              "docs/**"
            ],
            "model": "claude-sonnet-5-5",
            "effort": {
              "min": "low",
              "max": "medium"
            }
          }
        ],
        "protectedPaths": [
          "tests/corpus/**",
          "scripts/ratchet.ts"
        ]
      },
      "expected": {
        "ok": true,
        "value": {
          "$schema": "./node_modules/phax/schemas/phax.schema.json",
          "acceptance": {
            "command": "./acceptance.sh"
          },
          "agent": {
