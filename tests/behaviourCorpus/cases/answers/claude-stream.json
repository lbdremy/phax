{
  "subject": "answers/claude-stream",
  "cases": [
    {
      "name": "reads a full stream",
      "input": [
        {
          "type": "system",
          "subtype": "init",
          "session_id": "sess-2",
          "claude_code_version": "2.1.312",
          "apiKeySource": "none"
        },
        {
          "type": "assistant",
          "message": {
            "id": "msg_1",
            "model": "claude-opus-5-5",
            "usage": {
              "input_tokens": 10,
              "output_tokens": 20,
              "cache_read_input_tokens": 300,
              "cache_creation_input_tokens": 40,
              "cache_creation": {
                "ephemeral_1h_input_tokens": 15,
                "ephemeral_5m_input_tokens": 25
              }
            }
          }
        },
        {
          "type": "rate_limit_event",
          "rate_limit_info": {
            "status": "allowed",
            "unifiedWindows": {
              "five_hour": {
                "utilization": 0.42,
                "resetsAt": 1793000000
              },
              "seven_day": {
                "utilization": 0.1,
                "resetsAt": 1793500000
              }
            }
          }
        },
        {
          "type": "result",
          "session_id": "sess-2",
          "duration_ms": 5000,
          "modelUsage": {
            "claude-opus-5-5": {
              "inputTokens": 10,
              "outputTokens": 20,
              "cacheReadInputTokens": 300,
              "cacheCreationInputTokens": 40,
              "costUSD": 0.12,
              "webSearchRequests": 0
            }
          }
        }
      ],
      "expected": {
        "ok": true,
        "value": {
          "apiKeySource": "none",
          "claudeCodeVersion": [
            2,
            1,
            312
          ],
          "events": [
            {
              "id": "msg_1",
              "kind": "message",
              "model": "claude-opus-5-5",
              "usage": {
                "cacheReadTokens": 300,
                "cacheWrite1hTokens": 15,
                "cacheWriteTokens": 40,
                "inputTokens": 10,
                "outputTokens": 20
              }
            },
            {
              "kind": "rate-limit",
              "readings": [
                {
                  "fraction": 0.42,
                  "resetsAtEpochSeconds": 1793000000,
                  "window": "five-hour"
                },
                {
                  "fraction": 0.1,
                  "resetsAtEpochSeconds": 1793500000,
                  "window": "seven-day"
                }
              ]
            }
          ],
          "result": {
            "durationMs": 5000,
            "modelUsage": {
              "claude-opus-5-5": {
                "cacheReadTokens": 300,
                "cacheWriteTokens": 40,
                "costUsd": 0.12,
                "inputTokens": 10,
                "outputTokens": 20
              }
            }
          },
          "sessionId": "sess-2",
          "undecodedRateLimitEvents": 0
        }
      }
