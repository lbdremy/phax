{
  "format": "architecture-report",
  "current": [
    {
      "name": "accepts a typical document",
      "input": {
        "$schema": "https://docs.phax.run/schemas/architecture-report/0.26.0.json",
        "body": "# Architecture — example",
        "parts": [
          {
            "id": "core-decide",
            "name": "core · decide",
            "description": "The pure decision logic.",
            "globs": [
              "src/core/decide/**"
            ]
          }
        ]
      },
      "expected": {
        "ok": true,
        "shape": "0.26.0",
        "value": {
          "$schema": "https://docs.phax.run/schemas/architecture-report/0.26.0.json",
          "body": "# Architecture — example",
          "parts": [
            {
              "description": "The pure decision logic.",
              "globs": [
                "src/core/decide/**"
              ],
              "id": "core-decide",
              "name": "core · decide"
            }
          ]
        }
      }
    },
