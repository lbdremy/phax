      }
    },
    {
      "name": "constraint runId minLength",
      "input": {
        "$schema": "https://docs.phax.run/schemas/review-record-manifest/0.29.0.json",
        "kind": "review",
        "runId": "",
        "review": "compliance-review"
      },
      "expected": {
        "ok": false,
        "refusal": "runId: Expected a non empty string, actual \"\""
      }
    },
    {
      "name": "constraint runId required",
      "input": {
        "$schema": "https://docs.phax.run/schemas/review-record-manifest/0.29.0.json",
        "kind": "review",
        "review": "compliance-review"
      },
      "expected": {
        "ok": false,
        "refusal": "runId: is missing"
      }
    }
  ],
