{
  "$schema": "./phax.schema.json",
  "version": 1,
  "name": "phax",
  "security": {
    "agentCommands": [
      "deno",
      "ctx7",
      "usage",
      "pnpm gen:usage-spec",
      "pnpm gen:model-catalog",
      "pnpm docs:cli",
      "pnpm add",
      "pnpm exec tsx",
      "pnpm dev schema upgrade",
      "smolvm",
      "entire --version",
      "entire --help",
      "git log",
      "git show-ref",
      "git cat-file",
      "git ls-tree",
      "git grep",
      "pnpm test:integration",
      "node"
    ]
  },
  "review": {
    "compliance": {
      "enabled": true
    },
    "code": {
      "enabled": true
    }
  },
  "publish": {
    "auto": true,
    "remote": "origin",
    "provider": "github",
    "pushBranch": true,
    "createPullRequest": true,
    "baseBranch": "main"
  },
  "commands": {
    "setup": ["pnpm install"],
    "cleanup": ["rm -rf node_modules"]
  },
  "acceptance": { "command": "node examples/vitest-acceptance/main.mjs" },
  "gateProfiles": {
    "standard": [
      { "command": "pnpm format", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm typecheck", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm test:type", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm lint", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm format:check", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm test", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm knip", "surface": "structural", "firing": "every-phase" },
      { "command": "pnpm audit:architecture", "surface": "structural", "firing": "every-phase" },
      {
        "command": "pnpm gen:model-catalog --check",
        "surface": "structural",
        "firing": "every-phase"
      },
      { "command": "pnpm build", "surface": "product", "firing": "terminal" },
      { "command": "pnpm site:build", "surface": "product", "firing": "terminal" },
      { "command": "pnpm deno:smoke", "surface": "product", "firing": "terminal" },
      { "command": "pnpm deno:smoke-binary", "surface": "product", "firing": "terminal" }
    ],
    "effect-migration": [
      { "command": "pnpm format", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm codemod:effect4 --ratchet", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm lint", "surface": "local", "firing": "every-phase" },
      { "command": "pnpm check:full", "surface": "local", "firing": "terminal" },
      { "command": "pnpm build", "surface": "product", "firing": "terminal" },
      { "command": "pnpm site:build", "surface": "product", "firing": "terminal" },
      { "command": "pnpm deno:smoke", "surface": "product", "firing": "terminal" },
      { "command": "pnpm deno:smoke-binary", "surface": "product", "firing": "terminal" }
    ]
  },
  "protectedPaths": [
    "tests/effect4Corpus/cases/**",
    "tests/effect4Corpus/baseline/**",
    "tests/effect4Corpus/corpus.ts",
    "tests/unit/effect4Corpus/**",
    "scripts/effect4-codemod/ratchet.ts",
    "scripts/effect4-codemod/counts.ts",
    "scripts/effect4-codemod/main.ts",
    "scripts/effect4-codemod/passingTests.ts",
    "tsconfig.json",
    "tsconfig.test.json",
    "vitest.config.ts",
    "tests/e2e/__snapshots__/**",
    "tests/integration/__snapshots__/**",
    "tests/integration/telemetry/__snapshots__/**",
    "tests/unit/__snapshots__/**",
    "tests/unit/reconciliation/__snapshots__/**",
    "packages/schemas/snapshots/**",
    "tests/fixtures/help/**",
    "tests/fixtures/usage/**",
    "tests/unit/commandLibrary/contract/fixtures/**",
    "tests/e2e/realFlow.test.ts",
    "tests/e2e/headlessAuthoring.test.ts",
    "tests/e2e/claudeProtectedPaths.test.ts",
    "tests/e2e/claudeSkillEditGrant.test.ts",
    "tests/unit/generateModelCatalog.test.ts",
    "tests/unit/reconciliation/global.test.ts"
  ],
  "records": {
    "transcript": true,
    "destination": {
      "kind": "repo",
      "remote": "git@github.com:lbdremy/phax-records.git"
    },
    "autoPush": true
  }
}
