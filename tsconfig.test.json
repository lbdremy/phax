{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "packages/schemas/**/*",
    "site/**/*",
    "scripts/effect4-corpus-capture.ts",
    "scripts/effect4-codemod/**/*.ts",
    "scripts/release-notes.ts",
    "scripts/rerender-spec.ts",
    "scripts/schemas-smoke.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/schemas/dist",
    "tests/e2e/fixtures",
    "tests/unit/effect4Codemod/__fixtures__",
    "site/generated",
    "site/doc_build"
  ]
}
