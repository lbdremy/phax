{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "packages/schemas/**/*",
    "site/**/*",
    "scripts/knip-baseline.ts",
    "scripts/knip-reporter.ts",
    "scripts/lint-baseline.ts",
    "scripts/release-notes.ts",
    "scripts/rerender-spec.ts",
    "scripts/schemas-smoke.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/schemas/dist",
    "tests/e2e/fixtures",
    "site/generated",
    "site/doc_build"
  ]
}
