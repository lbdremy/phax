#!/usr/bin/env node
"use strict";

// The npm launcher of phax: on a first run it downloads the release binary for
// this platform, verifies it against its published `.sha256` sidecar and places
// it in ~/.phax/bin/<version>/; every run then starts that binary.
//
// When required instead of run, the file starts nothing: it only exports its
// functions, each taking a config (productionConfig() in production) so tests
// can drive them against a local server.

const { spawn } = require("node:child_process");
const crypto = require("node:crypto");
const fs = require("node:fs");
const https = require("node:https");
const path = require("node:path");
const os = require("node:os");
const { pipeline } = require("node:stream");

// Binary names mirror RELEASE_TARGETS in scripts/build-binaries.ts.
const BINARY_NAMES = {
  darwin: { arm64: "phax-darwin-arm64", x64: "phax-darwin-x64" },
  linux: { x64: "phax-linux-x64", arm64: "phax-linux-arm64" },
};

const UPDATE_INTERVAL_MS = 24 * 60 * 60 * 1000; // once per day
const REDIRECT_STATUSES = new Set([301, 302, 303, 307, 308]);
// The signals forwarded to the binary, and that stop a first-run download.
const FORWARDED_SIGNALS = ["SIGINT", "SIGTERM", "SIGHUP"];
const START_REASONS = {
  EACCES: "permission denied",
  ENOENT: "no such file or directory",
  ENOEXEC: "exec format error",
  E2BIG: "argument list too long",
};

// The shipped values. `main` is the only production caller; nothing here reads
// the environment.
function productionConfig() {
  return {
    version: require("../package.json").version,
    home: os.homedir(),
    releaseBase: "https://github.com/lbdremy/phax/releases/download",
    updateUrl: "https://api.github.com/repos/lbdremy/phax/releases/latest",
    transport: https,
    scheme: "https:",
    allowedHosts: { exact: ["github.com", "api.github.com"], suffixes: ["githubusercontent.com"] },
    maxRedirects: 5,
    connectTimeoutMs: 10000,
    idleTimeoutMs: 30000,
    updateTimeoutMs: 5000,
  };
}

function getBinaryName(platform, arch) {
  const name = BINARY_NAMES[platform] && BINARY_NAMES[platform][arch];
  if (!name) {
    throw new Error(
      `Unsupported platform: ${platform}/${arch}. phax supports darwin and linux on arm64/x64 only.`,
    );
  }
  return name;
}

// The release publishes a `<name>.sha256` sidecar next to every binary.
function releaseUrls(config, name) {
  const binary = `${config.releaseBase}/v${config.version}/${name}`;
  return { binary, checksum: `${binary}.sha256` };
}

function cachePath(config, name) {
  return path.join(config.home, ".phax", "bin", config.version, name);
}

function updateCachePath(config) {
  return path.join(config.home, ".phax", "bin", ".update-check.json");
}

// The next URL of a redirect, resolved against the redirecting URL, or a throw
// when it leaves the scheme or the allowed hosts. A refused URL is never requested.
function checkRedirect(config, fromUrl, location) {
  const next = new URL(location, fromUrl);
  if (next.protocol !== config.scheme) {
    throw new Error(`refused redirect to ${next.href}: not ${config.scheme.replace(/:$/, "")}`);
  }
  const hostname = next.hostname.toLowerCase();
  const { exact, suffixes } = config.allowedHosts;
  if (!exact.includes(hostname) && !suffixes.some((suffix) => hostname.endsWith(`.${suffix}`))) {
    const allowed = [...exact, ...suffixes.map((suffix) => `*.${suffix}`)].join(" or ");
    throw new Error(`refused redirect to ${next.href}: host is not ${allowed}`);
  }
  return next.href;
}

function seconds(ms) {
  return String(ms / 1000);
}

// GET `originalUrl`, following checked redirects, and hand the final 200
// response to `consume`, which returns a Promise of the result. Every hop has a
// connect timer and an idle timeout. On any failure the request and the
// response are destroyed. `options.signal` aborts the request; `options.unref`
// keeps the request from holding the process.
function fetchUrl(config, originalUrl, consume, options = {}) {
  return new Promise((resolve, reject) => {
    let settled = false;
    const current = { req: null, res: null, connectTimer: null };

    function fail(err) {
      if (settled) return;
      settled = true;
      clearTimeout(current.connectTimer);
      if (current.res) current.res.destroy();
      if (current.req) current.req.destroy();
      reject(err);
    }

    function succeed(value) {
      if (settled) return;
      settled = true;
      resolve(value);
    }

    function hop(url, redirects) {
      const host = new URL(url).hostname;
      const requestOptions = { headers: { "User-Agent": `phax/${config.version}` } };
      if (options.signal) requestOptions.signal = options.signal;
      const req = config.transport.get(url, requestOptions, (res) => {
        if (settled || current.req !== req) {
          res.destroy();
          return;
        }
        current.res = res;
        const status = res.statusCode;
        if (REDIRECT_STATUSES.has(status)) {
          res.resume();
          const location = res.headers.location;
          if (!location) {
            fail(new Error(`HTTP ${status} without a Location header for ${url}`));
            return;
          }
          if (redirects >= config.maxRedirects) {
            fail(new Error(`more than ${config.maxRedirects} redirects from ${originalUrl}`));
            return;
          }
          let next;
          try {
            next = checkRedirect(config, url, location);
          } catch (err) {
            fail(err);
            return;
          }
          hop(next, redirects + 1);
          return;
        }
        if (status !== 200) {
          res.resume();
          fail(new Error(`HTTP ${status} for ${url}`));
          return;
        }
        consume(res).then(succeed, fail);
      });
      current.req = req;
      current.res = null;
      current.connectTimer = setTimeout(() => {
        fail(new Error(`no connection to ${host} within ${seconds(config.connectTimeoutMs)} s`));
      }, config.connectTimeoutMs);
      if (options.unref) current.connectTimer.unref();
      const connectTimer = current.connectTimer;

      req.on("error", (err) => {
        if (current.req === req) fail(err);
      });
      req.on("timeout", () => {
        if (current.req === req) fail(new Error(`no data from ${host} for ${seconds(config.idleTimeoutMs)} s`));
        else req.destroy();
      });
      req.on("socket", (socket) => {
        if (options.unref) socket.unref();
        function connected() {
          clearTimeout(connectTimer);
          req.setTimeout(config.idleTimeoutMs);
        }
        if (!socket.connecting) connected();
        else if (socket.encrypted) socket.once("secureConnect", connected);
        else socket.once("connect", connected);
      });
    }

    hop(originalUrl, 0);
  });
}

// Write the body at `url` to `dest` through a write stream, held in
// `transfer.file` once the response arrives so a signal guard can close it. The
// stream opens its file asynchronously: the promise settles only once the stream
// is closed, so no file appears in `dest`'s directory after it settles.
function download(config, url, dest, transfer) {
  const closed = () =>
    transfer.file === null || transfer.file.closed
      ? Promise.resolve()
      : new Promise((resolve) => transfer.file.once("close", resolve));
  return fetchUrl(
    config,
    url,
    (res) =>
      new Promise((resolve, reject) => {
        transfer.file = fs.createWriteStream(dest);
        pipeline(res, transfer.file, (err) => (err ? reject(err) : resolve()));
      }),
  ).then(closed, (err) => {
    if (transfer.file !== null) transfer.file.destroy();
    return closed().then(() => {
      throw err;
    });
  });
}

function fetchText(config, url) {
  return fetchUrl(
    config,
    url,
    (res) =>
      new Promise((resolve, reject) => {
        let data = "";
        res.setEncoding("utf8");
        res.on("data", (chunk) => (data += chunk));
        res.on("end", () => resolve(data));
        res.on("error", reject);
      }),
  );
}

function sha256File(filePath) {
  return new Promise((resolve, reject) => {
    const hash = crypto.createHash("sha256");
    const stream = fs.createReadStream(filePath);
    stream.on("error", reject);
    stream.on("data", (chunk) => hash.update(chunk));
    stream.on("end", () => resolve(hash.digest("hex")));
  });
}

// Remove a private download directory. A failure is not reported: a private
// directory is never run, and the caller's own outcome (the binary, the reason
// a download failed, the death by a signal) must not be replaced by an fs error.
function removePrivateDir(privateDir) {
  try {
    fs.rmSync(privateDir, { recursive: true, force: true });
  } catch {}
}

// The cache path of the binary, downloading and verifying it on a first run.
// The download happens in a private mkdtemp directory; only a verified,
// executable binary reaches the cache path, by one rename. The private
// directory is removed on success and on failure.
async function ensureBinary(config, name) {
  const dest = cachePath(config, name);
  if (fs.existsSync(dest)) return dest;

  const versionDir = path.dirname(dest);
  fs.mkdirSync(versionDir, { recursive: true });
  const privateDir = fs.mkdtempSync(path.join(versionDir, ".download-"));
  const transfer = { file: null };
  // A signal during the first run removes the private directory and ends the
  // launcher by that signal; the binary is never started. The download's write
  // stream may still be opening its file, so it is closed first: a removal
  // while the file is being created could leave the directory behind.
  let stopping = false;
  const guards = FORWARDED_SIGNALS.map((signal) => {
    const guard = () => {
      if (stopping) return;
      stopping = true;
      const stop = () => {
        removePrivateDir(privateDir);
        dieOf(signal);
      };
      const file = transfer.file;
      if (file === null || file.closed) {
        stop();
        return;
      }
      file.once("close", stop);
      file.destroy();
    };
    process.on(signal, guard);
    return [signal, guard];
  });
  try {
    const urls = releaseUrls(config, name);
    const privateFile = path.join(privateDir, name);
    try {
      await download(config, urls.binary, privateFile, transfer);
    } catch (err) {
      throw new Error(`download failed: ${err.message}`);
    }

    let text;
    try {
      text = await fetchText(config, urls.checksum);
    } catch (err) {
      throw new Error(
        `could not fetch checksum for ${name} from ${urls.checksum}: ${err.message}. ` +
          `Refusing to run an unverified binary.`,
      );
    }
    // sha256sum format: "<hex>  <name>"
    const expected = text.trim().split(/\s+/)[0];
    if (!/^[0-9a-f]{64}$/.test(expected)) {
      throw new Error(`malformed checksum for ${name} at ${urls.checksum}`);
    }
    const actual = await sha256File(privateFile);
    if (actual !== expected) {
      throw new Error(
        `checksum mismatch for ${name}: expected ${expected}, got ${actual}. ` +
          `The downloaded binary may be corrupt or tampered with; refusing to run it.`,
      );
    }

    fs.chmodSync(privateFile, 0o755);
    fs.renameSync(privateFile, dest);
    return dest;
  } finally {
    // Removed while the guards still hold the signals, so a signal right after
    // the guards go finds nothing left to clean.
    removePrivateDir(privateDir);
    for (const [signal, guard] of guards) process.removeListener(signal, guard);
  }
}

// Refresh the cached latest version. Always resolves, never prints, and never
// holds the process: it is abandoned silently after updateTimeoutMs.
function refreshUpdateCache(config) {
  return new Promise((resolve) => {
    const controller = new AbortController();
    const timer = setTimeout(() => {
      controller.abort();
      resolve();
    }, config.updateTimeoutMs);
    timer.unref();
    const finish = () => {
      clearTimeout(timer);
      resolve();
    };
    fetchUrl(
      config,
      config.updateUrl,
      (res) =>
        new Promise((done, reject) => {
          let data = "";
          res.setEncoding("utf8");
          res.on("data", (chunk) => (data += chunk));
          res.on("end", () => done(data));
          res.on("error", reject);
        }),
      { signal: controller.signal, unref: true },
    ).then((data) => {
      try {
        const latest = JSON.parse(data).tag_name.replace(/^v/, "");
        const cacheFile = updateCachePath(config);
        fs.mkdirSync(path.dirname(cacheFile), { recursive: true });
        fs.writeFileSync(cacheFile, JSON.stringify({ latest, checkedAt: Date.now() }));
      } catch {}
      finish();
    }, finish);
  });
}

// Reads cached latest version synchronously — no network on the hot path.
function readUpdateCache(config) {
  try {
    return JSON.parse(fs.readFileSync(updateCachePath(config), "utf8"));
  } catch {
    return null;
  }
}

function checkForUpdate(config) {
  const cache = readUpdateCache(config);

  // Trigger a background refresh if cache is missing or stale.
  if (!cache || Date.now() - cache.checkedAt > UPDATE_INTERVAL_MS) {
    refreshUpdateCache(config);
  }

  // Show notice if the cached latest differs from current version.
  if (cache && cache.latest && cache.latest !== config.version) {
    process.stderr.write(
      `\nphax: update available v${config.version} → v${cache.latest}\n` +
        `  to update: npm update -g @lbdremy/phax\n\n`,
    );
  }
}

// End this process by `signal`, as the binary ended: drop every listener so the
// default action applies, then re-raise it. A signal Node ignores by default
// (SIGPIPE) leaves the process alive; it then exits 128 + n on the next timer turn.
// SIGUSR1 is never re-raised: Node reserves it to start its inspector, which
// would open a debug port instead of ending the launcher. It exits 128 + n,
// the status a shell reports for that death.
function dieOf(signal) {
  if (signal === "SIGUSR1") {
    process.exit(128 + os.constants.signals.SIGUSR1);
    return;
  }
  process.removeAllListeners(signal);
  process.kill(process.pid, signal);
  setTimeout(() => process.exit(128 + (os.constants.signals[signal] || 0)), 0);
}

// Start the binary and resolve with how it ended: `{ code, signal }` on exit, or
// `{ error: { code, message } }` when it could not start. While it runs, SIGINT,
// SIGTERM and SIGHUP sent to the launcher are forwarded to it; the listeners
// are installed before the spawn and removed once the binary has ended.
function startBinary(binPath, args) {
  return new Promise((resolve) => {
    let child = null;
    let settled = false;
    const pending = [];
    const forwards = FORWARDED_SIGNALS.map((signal) => {
      const forward = () => {
        if (settled) return;
        if (child === null) pending.push(signal);
        else if (child.pid !== undefined && child.exitCode === null && child.signalCode === null) {
          child.kill(signal);
        }
      };
      process.on(signal, forward);
      return [signal, forward];
    });

    function settle(outcome) {
      if (settled) return;
      settled = true;
      for (const [signal, forward] of forwards) process.removeListener(signal, forward);
      resolve(outcome);
    }

    // Some start failures (ENOEXEC, E2BIG, macOS's EBADARCH) throw here instead
    // of arriving as an `error` event; both end in the same report.
    try {
      child = spawn(binPath, args, { stdio: "inherit" });
    } catch (err) {
      settle({ error: { code: err.code, message: err.message } });
      return;
    }
    child.on("error", (err) => settle({ error: { code: err.code, message: err.message } }));
    child.on("exit", (code, signal) => settle({ code, signal }));
    if (child.pid !== undefined) for (const signal of pending.splice(0)) child.kill(signal);
  });
}

// End the launcher as the binary ended: its exit code, its signal, or a start
// error reported with the path, the code, the reason and the remedy.
function exitLike(outcome, binPath, config) {
  if (outcome.error) {
    const code = outcome.error.code || "UNKNOWN";
    const reason = START_REASONS[code] || outcome.error.message;
    const versionDir = path.join(config.home, ".phax", "bin", config.version);
    process.stderr.write(
      `phax: could not start ${binPath}: ${code} (${reason})\n` +
        `  remove ${versionDir} and run phax again to download it afresh\n`,
    );
    process.exit(1);
    return;
  }
  if (outcome.signal) {
    dieOf(outcome.signal);
    return;
  }
  process.exit(outcome.code ?? 1);
}

// One run of the launcher: ensure the binary, start it, end as it ended.
async function launch(config, args) {
  const name = getBinaryName(process.platform, process.arch);

  if (!fs.existsSync(cachePath(config, name))) {
    process.stderr.write(`phax: downloading binary from ${releaseUrls(config, name).binary}\n`);
  }
  let binPath;
  try {
    binPath = await ensureBinary(config, name);
  } catch (err) {
    process.stderr.write(`phax: ${err.message}\n`);
    process.exit(1);
    return;
  }

  checkForUpdate(config);

  exitLike(await startBinary(binPath, args), binPath, config);
}

function main() {
  return launch(productionConfig(), process.argv.slice(2));
}

module.exports = {
  productionConfig,
  getBinaryName,
  releaseUrls,
  cachePath,
  checkRedirect,
  ensureBinary,
  refreshUpdateCache,
  checkForUpdate,
  launch,
  startBinary,
  exitLike,
};

if (require.main === module) {
  main().catch((err) => {
    process.stderr.write(`phax: ${err.message}\n`);
    process.exit(1);
  });
}
