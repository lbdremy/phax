{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax phax-plan",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "run",
    "phases"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The phax-plan format's shape, named by the phax release that last changed it (not necessarily the release that wrote this file): https://docs.phax.run/schemas/phax-plan/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/phax-plan\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "run": {
      "type": "object",
      "required": [
        "shortName",
        "title",
        "branch",
        "requiredCommands"
      ],
      "properties": {
        "shortName": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "branch": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "requiredCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "model",
          "effort",
          "planMarkdownAnchor",
          "plannedFilesToCreate",
          "plannedFilesToEdit",
          "optionalFilesToEdit",
          "mode",
          "oracle",
          "testLines",
          "commit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "a string matching the pattern ^phase-\\d{2}$",
            "pattern": "^phase-\\d{2}$"
          },
          "title": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "model": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "effort": {
            "type": "string",
            "enum": [
              "none",
              "off",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultracode",
              "ultra"
            ]
          },
          "planMarkdownAnchor": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "plannedFilesToCreate": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plannedFilesToEdit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optionalFilesToEdit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "headless",
              "interactive"
            ]
          },
          "oracle": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "dischargedBy",
                  "files"
                ],
                "properties": {
                  "dischargedBy": {
                    "type": "string",
                    "description": "a string matching the pattern ^phase-\\d{2}$",
                    "pattern": "^phase-\\d{2}$"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/NonEmptyString"
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "testLines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "guarantee",
                "size",
                "technique",
                "oracle",
                "loop",
                "criterion"
              ],
              "properties": {
                "guarantee": {
                  "type": "string",
                  "description": "What the test guarantees: one non-empty, trimmed line.",
                  "pattern": "^(?!\\s)[\\s\\S]*\\S$",
                  "allOf": [
                    {
                      "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]*$"
                    }
                  ]
                },
                "size": {
                  "type": "string",
                  "enum": [
                    "small",
                    "medium",
                    "large"
                  ]
                },
                "technique": {
                  "type": "string",
                  "enum": [
                    "example",
                    "table",
                    "property",
                    "metamorphic",
                    "stateful",
                    "fuzz",
                    "contract",
                    "smoke"
                  ]
                },
                "oracle": {
                  "type": "string",
                  "description": "What the test compares against: one non-empty, trimmed line, never holding ' — ', never starting with '— ' and never ending with ' ·'.",
                  "pattern": "^(?![\\s\\S]* ·$)",
                  "allOf": [
                    {
                      "pattern": "^(?!— )"
                    },
                    {
                      "pattern": "^(?![\\s\\S]* — )"
                    },
                    {
                      "pattern": "^(?!\\s)[\\s\\S]*\\S$"
                    },
                    {
                      "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]*$"
                    }
                  ]
                },
                "loop": {
                  "type": "string",
                  "enum": [
                    "oracle",
                    "in-phase"
                  ]
                },
                "criterion": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "An acceptance criterion id from the source spec's JSON sidecar: a run of non-whitespace characters, no backtick, neither 'oracle' nor 'in-phase'.",
                      "pattern": "^(?!(?:oracle|in-phase)$)",
                      "allOf": [
                        {
                          "pattern": "^[^\\s`\\x00-\\x1F\\x7F-\\x9F]+$"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "description": "One test line of a phase's test strategy, rendered as `- <guarantee> — <size> · <technique> · <oracle> · <loop>[ · <criterion>]`, one per line under the phase's `### Test strategy` heading. `criterion` is an acceptance criterion id from the source spec's JSON sidecar, or null."
            }
          },
          "commit": {
            "type": "object",
            "required": [
              "subject",
              "body"
            ],
            "properties": {
              "subject": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "body": {
                "$ref": "#/$defs/NonEmptyString"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
