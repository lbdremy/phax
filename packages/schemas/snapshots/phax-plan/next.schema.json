{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax phax-plan",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "run",
    "phases"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The phax-plan format and the phax release that wrote this file: https://docs.phax.run/schemas/phax-plan/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/phax-plan\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "run": {
      "type": "object",
      "required": [
        "shortName",
        "title",
        "branch",
        "requiredCommands"
      ],
      "properties": {
        "shortName": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "branch": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "requiredCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "model",
          "effort",
          "planMarkdownAnchor",
          "plannedFilesToCreate",
          "plannedFilesToEdit",
          "optionalFilesToEdit",
          "commit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "a string matching the pattern ^phase-\\d{2}$",
            "pattern": "^phase-\\d{2}$"
          },
          "title": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "model": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "effort": {
            "type": "string",
            "enum": [
              "none",
              "off",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultracode",
              "ultra"
            ]
          },
          "planMarkdownAnchor": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "plannedFilesToCreate": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plannedFilesToEdit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optionalFilesToEdit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commit": {
            "type": "object",
            "required": [
              "subject",
              "body"
            ],
            "properties": {
              "subject": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "body": {
                "$ref": "#/$defs/NonEmptyString"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
