{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax plan document",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "version",
    "kind",
    "sourceSpec",
    "run",
    "preamble",
    "phases"
  ],
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "plan"
      ]
    },
    "sourceSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "shortName",
        "title",
        "requiredCommands"
      ],
      "properties": {
        "shortName": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "requiredCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "preamble": {
      "type": "object",
      "required": [
        "summary",
        "requiredCommandsNote",
        "technicalArbitrations"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "requiredCommandsNote": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "technicalArbitrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        }
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "model",
          "effort",
          "planMarkdownAnchor",
          "plannedFilesToCreate",
          "plannedFilesToEdit",
          "optionalFilesToEdit",
          "commit",
          "title",
          "objective",
          "detailedInstructions",
          "boundaryContracts",
          "testStrategy",
          "implementationOrder",
          "excludedScope",
          "verification",
          "expectedHandoff"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "a string matching the pattern ^phase-\\d{2}$",
            "pattern": "^phase-\\d{2}$"
          },
          "model": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "effort": {
            "type": "string",
            "enum": [
              "none",
              "off",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultracode",
              "ultra"
            ]
          },
          "planMarkdownAnchor": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "plannedFilesToCreate": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plannedFilesToEdit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optionalFilesToEdit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commit": {
            "type": "object",
            "required": [
              "subject",
              "body"
            ],
            "properties": {
              "subject": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "body": {
                "$ref": "#/$defs/NonEmptyString"
              }
            },
            "additionalProperties": false
          },
          "title": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "objective": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "detailedInstructions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/NonEmptyString"
            }
          },
          "boundaryContracts": {
            "anyOf": [
              {
                "$ref": "#/$defs/NonEmptyString"
              },
              {
                "type": "null"
              }
            ]
          },
          "testStrategy": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "implementationOrder": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/NonEmptyString"
            }
          },
          "excludedScope": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/NonEmptyString"
            }
          },
          "verification": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "expectedHandoff": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
