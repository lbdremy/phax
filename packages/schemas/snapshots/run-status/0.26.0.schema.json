{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax run status",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "namespace",
    "shortName",
    "runId",
    "state",
    "createdAt",
    "updatedAt",
    "phasesCount",
    "hold"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The run-status format's shape, named by the phax release that last changed it (not necessarily the release that wrote this file): https://docs.phax.run/schemas/run-status/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/run-status\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "namespace": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "shortName": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "runId": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "state": {
      "type": "string",
      "enum": [
        "created",
        "running",
        "failed",
        "review_open",
        "completed",
        "stopped",
        "archived",
        "interrupted",
        "rate_limited",
        "awaiting_review"
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "updatedAt": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "phasesCount": {
      "type": "number"
    },
    "currentPhaseIndex": {
      "type": "number"
    },
    "gateProfileId": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "stoppedReason": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "lastError": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "planRepoRelPath": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "allowSkillEdits": {
      "type": "boolean"
    },
    "hold": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "selection"
          ],
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "selection",
            "phases"
          ],
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "all"
              ]
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "description": "a string matching the pattern ^phase-\\d{2}$",
                "pattern": "^phase-\\d{2}$"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "selection",
            "phases"
          ],
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "listed"
              ]
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "description": "a string matching the pattern ^phase-\\d{2}$",
                "pattern": "^phase-\\d{2}$"
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "selection",
            "phases"
          ],
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "oracle"
              ]
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "description": "a string matching the pattern ^phase-\\d{2}$",
                "pattern": "^phase-\\d{2}$"
              }
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
