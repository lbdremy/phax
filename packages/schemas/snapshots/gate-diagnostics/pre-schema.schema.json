{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax gate diagnostics document",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    }
  },
  "type": "object",
  "required": [
    "diagnostics"
  ],
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "class",
              "rule",
              "location",
              "message",
              "repair"
            ],
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "invariant"
                ]
              },
              "rule": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "location": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/NonEmptyString"
                  },
                  "line": {
                    "$ref": "#/$defs/Int",
                    "description": "a positive number",
                    "title": "positive",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": true
              },
              "message": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "repair": {
                "$ref": "#/$defs/NonEmptyString"
              }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": [
              "class",
              "scopes",
              "rule",
              "location",
              "message",
              "repair"
            ],
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "completion"
                ]
              },
              "scopes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              },
              "rule": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "location": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/NonEmptyString"
                  },
                  "line": {
                    "$ref": "#/$defs/Int",
                    "description": "a positive number",
                    "title": "positive",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": true
              },
              "message": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "repair": {
                "$ref": "#/$defs/NonEmptyString"
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
