{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax plan extraction",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a string matching the pattern ^[\\s\\S]+$",
      "pattern": "^[\\s\\S]+$"
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "plan",
    "incomplete"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://docs.phax.run/schemas/phax-plan-extraction/0.32.0.json"
      ],
      "description": "The phax-plan-extraction format's shape, exactly: https://docs.phax.run/schemas/phax-plan-extraction/0.32.0.json",
      "const": "https://docs.phax.run/schemas/phax-plan-extraction/0.32.0.json"
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "run",
            "phases"
          ],
          "properties": {
            "run": {
              "type": "object",
              "required": [
                "shortName",
                "title",
                "requiredCommands"
              ],
              "properties": {
                "shortName": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "title": {
                  "$ref": "#/$defs/NonEmptyString"
                },
                "requiredCommands": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "model",
                  "effort",
                  "planMarkdownAnchor",
                  "plannedFilesToCreate",
                  "plannedFilesToEdit",
                  "optionalFilesToEdit",
                  "testLines",
                  "commit"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "a string matching the pattern ^phase-\\d{2}$",
                    "pattern": "^phase-\\d{2}$"
                  },
                  "model": {
                    "$ref": "#/$defs/NonEmptyString"
                  },
                  "effort": {
                    "type": "string",
                    "enum": [
                      "none",
                      "off",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max",
                      "ultracode",
                      "ultra"
                    ]
                  },
                  "planMarkdownAnchor": {
                    "$ref": "#/$defs/NonEmptyString"
                  },
                  "plannedFilesToCreate": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "plannedFilesToEdit": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "optionalFilesToEdit": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "testLines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "guarantee",
                        "size",
                        "technique",
                        "oracle",
                        "loop",
                        "criterion"
                      ],
                      "properties": {
                        "guarantee": {
                          "type": "string",
                          "description": "What the test guarantees: one non-empty, trimmed line.",
                          "pattern": "^[^\\s\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029](?:[^\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]*[^\\s\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029])?$"
                        },
                        "size": {
                          "type": "string",
                          "enum": [
                            "small",
                            "medium",
                            "large"
                          ]
                        },
                        "technique": {
                          "type": "string",
                          "enum": [
                            "example",
                            "table",
                            "property",
                            "metamorphic",
                            "stateful",
                            "fuzz",
                            "contract",
                            "smoke"
                          ]
                        },
                        "oracle": {
                          "type": "string",
                          "description": "What the test compares against: one non-empty, trimmed line, never holding ' — ', never starting with '— ' and never ending with ' ·' (these three checked by phax, not by this JSON Schema).",
                          "pattern": "^[^\\s\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029](?:[^\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]*[^\\s\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029])?$"
                        },
                        "loop": {
                          "type": "string",
                          "enum": [
                            "oracle",
                            "in-phase"
                          ]
                        },
                        "criterion": {
                          "anyOf": [
                            {
                              "type": "string",
                              "description": "An acceptance criterion id from the source spec's JSON sidecar: a run of non-whitespace characters, no backtick, neither 'oracle' nor 'in-phase' (that last checked by phax, not by this JSON Schema).",
                              "pattern": "^[^\\s`\\x00-\\x1F\\x7F-\\x9F]+$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false,
                      "description": "One test line of a phase's test strategy, rendered as `- <guarantee> — <size> · <technique> · <oracle> · <loop>[ · <criterion>]`, one per line under the phase's `### Test strategy` heading. `criterion` is an acceptance criterion id from the source spec's JSON sidecar, or null."
                    }
                  },
                  "commit": {
                    "type": "object",
                    "required": [
                      "subject",
                      "body"
                    ],
                    "properties": {
                      "subject": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "body": {
                        "$ref": "#/$defs/NonEmptyString"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The extracted plan, or null when the plan is incomplete."
    },
    "incomplete": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonEmptyString"
        },
        {
          "type": "null"
        }
      ],
      "description": "What is missing from the plan, or a test strategy item not in the line format; null when the plan is extracted."
    }
  },
  "additionalProperties": false,
  "description": "Exactly one of plan and incomplete is null."
}
