{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax gate attribution",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "phase",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The gate-attribution format and the phax release that wrote this file: https://docs.phax.run/schemas/gate-attribution/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/gate-attribution\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "phase": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "surface",
          "result"
        ],
        "properties": {
          "command": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "surface": {
            "type": "string",
            "enum": [
              "local",
              "structural",
              "product"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "pending"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
