{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax interactive handoff",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a string matching the pattern ^[\\s\\S]+$",
      "pattern": "^[\\s\\S]+$"
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "corrections",
    "patternFromNowOn",
    "nextPhasesNeedToKnow"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://docs.phax.run/schemas/interactive-handoff/0.32.0.json"
      ],
      "description": "The interactive-handoff format's shape, exactly: https://docs.phax.run/schemas/interactive-handoff/0.32.0.json",
      "const": "https://docs.phax.run/schemas/interactive-handoff/0.32.0.json"
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "what",
          "guard"
        ],
        "properties": {
          "what": {
            "type": "string",
            "description": "What was corrected.",
            "pattern": "^[\\s\\S]+$"
          },
          "guard": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "ref"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "test",
                      "lint",
                      "gate-step"
                    ],
                    "description": "What now guards the correction."
                  },
                  "ref": {
                    "type": "string",
                    "description": "The test, lint rule or gate step that guards it.",
                    "pattern": "^[\\s\\S]+$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "none"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why nothing guards it.",
                    "pattern": "^[\\s\\S]+$"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "patternFromNowOn": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "nextPhasesNeedToKnow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    }
  },
  "additionalProperties": false
}
