{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax interactive handoff",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "corrections",
    "patternFromNowOn",
    "nextPhasesNeedToKnow"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The interactive-handoff format's shape, named by the phax release that last changed it (not necessarily the release that wrote this file): https://docs.phax.run/schemas/interactive-handoff/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/interactive-handoff\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "what",
          "guard"
        ],
        "properties": {
          "what": {
            "type": "string",
            "description": "What was corrected.",
            "title": "nonEmptyString",
            "minLength": 1
          },
          "guard": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "ref"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "test",
                      "lint",
                      "gate-step"
                    ],
                    "description": "What now guards the correction."
                  },
                  "ref": {
                    "type": "string",
                    "description": "The test, lint rule or gate step that guards it.",
                    "title": "nonEmptyString",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "none"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why nothing guards it.",
                    "title": "nonEmptyString",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "patternFromNowOn": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    },
    "nextPhasesNeedToKnow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      }
    }
  },
  "additionalProperties": false
}
