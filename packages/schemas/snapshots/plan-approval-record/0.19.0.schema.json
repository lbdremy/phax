{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax plan approval record",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "artifact",
    "planFingerprint",
    "approvedAt",
    "baseline",
    "sourceSpec"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The plan-approval-record format and the phax release that wrote this file: https://docs.phax.run/schemas/plan-approval-record/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/plan-approval-record\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "artifact": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "planFingerprint": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "approvedAt": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "baseline": {
      "$ref": "#/$defs/NonEmptyString",
      "description": "a string matching the pattern ^[0-9a-f]{40}$",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceSpec": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "fingerprint"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "fingerprint": {
              "$ref": "#/$defs/NonEmptyString"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
