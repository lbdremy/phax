{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax plan approval record",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "artifact",
    "planFingerprint",
    "approvedAt",
    "baseline",
    "sourceSpec",
    "approvedBy"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The plan-approval-record format's shape, named by the phax release that last changed it (not necessarily the release that wrote this file): https://docs.phax.run/schemas/plan-approval-record/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/plan-approval-record\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "artifact": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "planFingerprint": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "approvedAt": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "baseline": {
      "$ref": "#/$defs/NonEmptyString",
      "description": "a string matching the pattern ^[0-9a-f]{40}$",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceSpec": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "fingerprint"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/NonEmptyString"
            },
            "fingerprint": {
              "$ref": "#/$defs/NonEmptyString"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "approvedBy": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "grant"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "machine"
              ]
            },
            "grant": {
              "type": "string",
              "description": "The grant the machine declared with `--by machine:<grant>`.",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "operator"
              ]
            },
            "name": {
              "type": "string",
              "description": "The operator's git user.name when they approved.",
              "title": "nonEmptyString",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unattributed"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
