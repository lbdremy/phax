              },
              "landed": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "found"
                            ]
                          },
                          "by": {
                            "type": "string",
                            "enum": [
                              "recorded",
                              "key",
                              "patch-id"
                            ],
                            "description": "The step that matched: recorded (the branch reaches the recorded commit), key (one commit carries the Finding-Run and Finding trailers) or patch-id (one commit has the recorded commit's stable patch id)."
                          },
                          "commit": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                            "description": "The commit the fix landed as: the recorded commit when found by recorded."
                          },
                          "branch": {
                            "$ref": "#/$defs/NonEmptyString_6"
                          },
                          "recorded": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                            "description": "The commit the latest fixed record names."
                          }
                        },
                        "required": [
                          "status",
                          "by",
                          "commit",
                          "branch",
                          "recorded"
                        ],
                        "additionalProperties": false,
                        "description": "The fix was found on a branch by one commit."
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "ambiguous"
                            ]
                          },
                          "commits": {
                            "type": "array",
                            "minItems": 2,
                            "description": "Every commit that matched the step, oldest first: two or more.",
                            "items": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                              "description": "A commit that matched."
                            }
                          },
                          "branch": {
                            "$ref": "#/$defs/NonEmptyString_6"
                          },
                          "recorded": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                            "description": "The commit the latest fixed record names."
                          }
                        },
                        "required": [
                          "status",
                          "commits",
                          "branch",
                          "recorded"
                        ],
                        "additionalProperties": false,
                        "description": "Several commits of one branch matched the same step."
                      },
                      {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "not-found"
                            ]
                          },
                          "branches": {
                            "type": "array",
                            "minItems": 1,
                            "description": "Every branch looked for, in search order: the base branch, then the run's branch whenever the run has one, even when it no longer resolves.",
