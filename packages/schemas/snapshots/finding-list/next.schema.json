                            }
                          },
                          "recorded": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
                            "description": "The commit the latest fixed record names."
                          }
                        },
                        "required": [
                          "status",
                          "branches",
                          "recorded"
                        ],
                        "additionalProperties": false,
                        "description": "The fix was found on no branch looked for."
                      }
                    ],
                    "description": "Where the latest fix landed: found, ambiguous or not-found, on the base branch then the run's branch, among commits made since the run started."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The resolution of the latest fix of a fixed finding, read when the list was made; null for every other fate."
              }
            },
            "required": [
              "id",
              "source",
              "severity",
              "file",
              "line",
              "message",
              "lens",
              "escape",
              "criterion",
              "suggestion",
              "fate",
              "history",
              "landed"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
