{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax phase record manifest",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "runId",
    "phaseId",
    "shape",
    "model",
    "effort",
    "provider",
    "outcome",
    "usage",
    "verifiedSurfaces",
    "oracle",
    "mode",
    "stop"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The phase-record-manifest format's shape, named by the phax release that last changed it (not necessarily the release that wrote this file): https://docs.phax.run/schemas/phase-record-manifest/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/phase-record-manifest\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "runId": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "phaseId": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "shape": {
      "type": "string",
      "enum": [
        "full",
        "skeleton"
      ]
    },
    "sourceSha": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "model": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "effort": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "provider": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex-cli",
        "mistral-vibe"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "committed",
        "failed",
        "abandoned",
        "interrupted"
      ]
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "available",
            "usage"
          ],
          "properties": {
            "available": {
              "type": "boolean",
              "enum": [
                true
              ]
            },
            "usage": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "provider",
                    "inputTokens",
                    "cacheCreationInputTokens",
                    "cacheReadInputTokens",
                    "outputTokens",
                    "totalCostUsd"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string",
                      "enum": [
                        "claude-code"
                      ]
                    },
                    "inputTokens": {
                      "type": "number"
                    },
                    "cacheCreationInputTokens": {
                      "type": "number"
                    },
                    "cacheReadInputTokens": {
                      "type": "number"
                    },
                    "outputTokens": {
                      "type": "number"
                    },
                    "totalCostUsd": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "provider",
                    "inputTokens",
                    "cachedInputTokens",
                    "outputTokens",
                    "reasoningOutputTokens"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string",
                      "enum": [
                        "codex-cli"
                      ]
                    },
                    "inputTokens": {
                      "type": "number"
                    },
                    "cachedInputTokens": {
                      "type": "number"
                    },
                    "outputTokens": {
                      "type": "number"
                    },
                    "reasoningOutputTokens": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "provider",
                    "inputTokens",
                    "outputTokens",
                    "sessionCostUsd",
                    "toolCallsAgreed",
                    "toolCallsRejected",
                    "toolCallsFailed",
                    "toolCallsSucceeded"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string",
                      "enum": [
                        "mistral-vibe"
                      ]
                    },
                    "inputTokens": {
                      "type": "number"
                    },
                    "outputTokens": {
                      "type": "number"
                    },
                    "sessionCostUsd": {
                      "type": "number"
                    },
                    "toolCallsAgreed": {
                      "type": "number"
                    },
                    "toolCallsRejected": {
                      "type": "number"
                    },
                    "toolCallsFailed": {
                      "type": "number"
                    },
                    "toolCallsSucceeded": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "verifiedSurfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "local",
          "structural",
          "product",
          "oracle"
        ]
      }
    },
    "oracle": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "role",
                "dischargedBy"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "oracle"
                  ]
                },
                "dischargedBy": {
                  "type": "string",
                  "description": "a string matching the pattern ^phase-\\d{2}$",
                  "pattern": "^phase-\\d{2}$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "role",
                "oraclePhase"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "discharging"
                  ]
                },
                "oraclePhase": {
                  "type": "string",
                  "description": "a string matching the pattern ^phase-\\d{2}$",
                  "pattern": "^phase-\\d{2}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "headless",
        "interactive"
      ]
    },
    "stop": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "cause",
                "outcome",
                "closedBy",
                "sessions"
              ],
              "properties": {
                "cause": {
                  "type": "string",
                  "enum": [
                    "declared"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "corrected"
                  ]
                },
                "closedBy": {
                  "type": "object",
                  "required": [
                    "name",
                    "email"
                  ],
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/NonEmptyString"
                    },
                    "email": {
                      "$ref": "#/$defs/NonEmptyString"
                    }
                  },
                  "additionalProperties": false,
                  "description": "The git identity of the checkout that closed the stop."
                },
                "sessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "provider",
                      "model",
                      "effort",
                      "sessionId",
                      "origin",
                      "transcript"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "enum": [
                          "claude-code",
                          "codex-cli",
                          "mistral-vibe"
                        ]
                      },
                      "model": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "effort": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "sessionId": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "first-turn",
                          "new-session",
                          "builder"
                        ]
                      },
                      "transcript": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "sha256"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "captured"
                                ]
                              },
                              "sha256": {
                                "type": "string",
                                "description": "The sha256 of the transcript copy's bytes.",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "reason",
                              "detail"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "missing"
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "not-found",
                                  "unreadable"
                                ]
                              },
                              "detail": {
                                "$ref": "#/$defs/NonEmptyString"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "cause",
                "outcome",
                "closedBy",
                "sessions"
              ],
              "properties": {
                "cause": {
                  "type": "string",
                  "enum": [
                    "declared"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "unchanged"
                  ]
                },
                "closedBy": {
                  "type": "object",
                  "required": [
                    "name",
                    "email"
                  ],
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/NonEmptyString"
                    },
                    "email": {
                      "$ref": "#/$defs/NonEmptyString"
                    }
                  },
                  "additionalProperties": false,
                  "description": "The git identity of the checkout that closed the stop."
                },
                "sessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "provider",
                      "model",
                      "effort",
                      "sessionId",
                      "origin",
                      "transcript"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "enum": [
                          "claude-code",
                          "codex-cli",
                          "mistral-vibe"
                        ]
                      },
                      "model": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "effort": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "sessionId": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "first-turn",
                          "new-session",
                          "builder"
                        ]
                      },
                      "transcript": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "sha256"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "captured"
                                ]
                              },
                              "sha256": {
                                "type": "string",
                                "description": "The sha256 of the transcript copy's bytes.",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "reason",
                              "detail"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "missing"
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "not-found",
                                  "unreadable"
                                ]
                              },
                              "detail": {
                                "$ref": "#/$defs/NonEmptyString"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "cause",
                "outcome",
                "reviewCommit",
                "closedBy",
                "sessions"
              ],
              "properties": {
                "cause": {
                  "type": "string",
                  "enum": [
                    "held"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "corrected"
                  ]
                },
                "reviewCommit": {
                  "type": "string",
                  "description": "A commit's full object name: 40 lowercase hex digits (SHA-1) or 64 (SHA-256).",
                  "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                },
                "closedBy": {
                  "type": "object",
                  "required": [
                    "name",
                    "email"
                  ],
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/NonEmptyString"
                    },
                    "email": {
                      "$ref": "#/$defs/NonEmptyString"
                    }
                  },
                  "additionalProperties": false,
                  "description": "The git identity of the checkout that closed the stop."
                },
                "sessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "provider",
                      "model",
                      "effort",
                      "sessionId",
                      "origin",
                      "transcript"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "enum": [
                          "claude-code",
                          "codex-cli",
                          "mistral-vibe"
                        ]
                      },
                      "model": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "effort": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "sessionId": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "first-turn",
                          "new-session",
                          "builder"
                        ]
                      },
                      "transcript": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "sha256"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "captured"
                                ]
                              },
                              "sha256": {
                                "type": "string",
                                "description": "The sha256 of the transcript copy's bytes.",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "reason",
                              "detail"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "missing"
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "not-found",
                                  "unreadable"
                                ]
                              },
                              "detail": {
                                "$ref": "#/$defs/NonEmptyString"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "cause",
                "outcome",
                "closedBy",
                "sessions"
              ],
              "properties": {
                "cause": {
                  "type": "string",
                  "enum": [
                    "held"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "unchanged"
                  ]
                },
                "closedBy": {
                  "type": "object",
                  "required": [
                    "name",
                    "email"
                  ],
                  "properties": {
                    "name": {
                      "$ref": "#/$defs/NonEmptyString"
                    },
                    "email": {
                      "$ref": "#/$defs/NonEmptyString"
                    }
                  },
                  "additionalProperties": false,
                  "description": "The git identity of the checkout that closed the stop."
                },
                "sessions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "provider",
                      "model",
                      "effort",
                      "sessionId",
                      "origin",
                      "transcript"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "enum": [
                          "claude-code",
                          "codex-cli",
                          "mistral-vibe"
                        ]
                      },
                      "model": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "effort": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "sessionId": {
                        "$ref": "#/$defs/NonEmptyString"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "first-turn",
                          "new-session",
                          "builder"
                        ]
                      },
                      "transcript": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "sha256"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "captured"
                                ]
                              },
                              "sha256": {
                                "type": "string",
                                "description": "The sha256 of the transcript copy's bytes.",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "required": [
                              "status",
                              "reason",
                              "detail"
                            ],
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "missing"
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "not-found",
                                  "unreadable"
                                ]
                              },
                              "detail": {
                                "$ref": "#/$defs/NonEmptyString"
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
