{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax first reading",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "pattern",
    "copiedBy",
    "toCheck"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The first-reading format's shape, named by the phax release that last changed it (not necessarily the release that wrote this file): https://docs.phax.run/schemas/first-reading/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/first-reading\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "pattern": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      },
      "description": "The pattern the phase introduces, one statement per item."
    },
    "copiedBy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "what"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "description": "The phase that copied the pattern.",
            "pattern": "^phase-\\d{2}$"
          },
          "what": {
            "type": "string",
            "description": "What it copied.",
            "title": "nonEmptyString",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "toCheck": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      },
      "description": "What the person should check first."
    }
  },
  "additionalProperties": false
}
