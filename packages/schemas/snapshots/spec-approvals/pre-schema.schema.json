{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax spec approvals ledger",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "version",
    "records"
  ],
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "records": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "object",
        "required": [
          "specFingerprint",
          "approvedAt",
          "baseline"
        ],
        "properties": {
          "specFingerprint": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "approvedAt": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "baseline": {
            "$ref": "#/$defs/NonEmptyString",
            "description": "a string matching the pattern ^[0-9a-f]{40}$",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
