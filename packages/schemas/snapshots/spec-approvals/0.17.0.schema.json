{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax spec approvals ledger",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "records"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The spec-approvals format and the phax release that wrote this file: https://docs.phax.run/schemas/spec-approvals/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/spec-approvals\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "records": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "type": "object",
        "required": [
          "specFingerprint",
          "approvedAt",
          "baseline"
        ],
        "properties": {
          "specFingerprint": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "approvedAt": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "baseline": {
            "$ref": "#/$defs/NonEmptyString",
            "description": "a string matching the pattern ^[0-9a-f]{40}$",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
