{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phax review record manifest",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "kind",
    "runId",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The review-record-manifest format's shape, named by the phax release that last changed it (not necessarily the release that wrote this file): https://docs.phax.run/schemas/review-record-manifest/<X.Y.Z>.json",
      "pattern": "^https:\\/\\/docs\\.phax\\.run\\/schemas\\/review-record-manifest\\/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.json$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "review"
      ]
    },
    "runId": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "review": {
      "type": "string",
      "enum": [
        "compliance-review",
        "code-review"
      ]
    }
  },
  "additionalProperties": false
}
